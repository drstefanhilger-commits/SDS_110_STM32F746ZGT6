# UART0 (GPIO20/21) gehört dem STM32 (USART3): Konsole und Logs auf USB-Serial/JTAG (GPIO18/19),
# keine zweite Konsole auf UART0 – sonst landen Logmeldungen als Bytes im Kommandostrom des STM32.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# 4 MB Flash (MINI-1-N4)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# 1-ms-Tick: geringe Latenz für Feedback (Id 8, bis 31/s)
CONFIG_FREERTOS_HZ=1000
# Firmware-Update per WLAN: Partitionen factory + ota_0 + ota_1, Rollback bei fehlerhafter Firmware
CONFIG_PARTITION_TABLE_TWO_OTA=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# kleineres Image: schnelleres OTA, Reserve in den 1-MB-Partitionen
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
